---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import ProductGrid from "../../components/ProductGrid.astro";

const API_URL = "https://fakestoreapi.com";

export async function getStaticPaths() {
  const response = await fetch(`${API_URL}/products/categories`);

  if (!response.ok) {
    throw new Error("No se pudieron obtener las categorías.");
  }

  const categories: string[] = await response.json();

  return categories.map((category) => ({
    params: {
      category: encodeURIComponent(category),
    },
  }));
}

const { category } = Astro.params;

const decodedCategory = decodeURIComponent(category);

const response = await fetch(
  `${API_URL}/products/category/${encodeURIComponent(decodedCategory)}`,
);

if (!response.ok) {
  throw new Error(`No se pudieron obtener productos de ${decodedCategory}.`);
}

const products = await response.json();
---

<MainLayout
  title={`${decodedCategory} | Nómada Store`}
  description={`Productos de ${decodedCategory}`}
>
  <Header />

  <main class="mx-auto max-w-7xl px-6 py-16">
    <a
      href="/categories"
      class="text-sm font-medium text-neutral-500
             hover:text-neutral-950"
    >
      ← Todas las categorías
    </a>

    <div class="mt-10 mb-10">
      <span
        class="text-sm font-semibold uppercase
               tracking-widest text-brand-600"
      >
        Categoría
      </span>

      <h1
        class="mt-3 text-4xl font-bold
               capitalize tracking-tight
               text-neutral-950"
      >
        {decodedCategory}
      </h1>

      <p class="mt-3 text-neutral-500">
        {products.length} productos encontrados.
      </p>
    </div>

    {
      products.length > 0 ? (
        <ProductGrid products={products} />
      ) : (
        <div
          class="rounded-2xl border border-dashed
                 border-neutral-300 p-12 text-center"
        >
          <p class="text-neutral-500">No encontramos productos.</p>
        </div>
      )
    }
  </main>
</MainLayout>
