]
---

<Layout>
    <body class='bg-zinc-50 text-zinc-950'>
        <main>
            <header>
                <p>Nuestra selección</p>
                <h1>Productos diseñados para ti</h1>
            </header>
        </main>
        <section>
            {productos.map((producto) => <ProductCard producto={producto} />)}
        </section>
    </body>
</Layout>

